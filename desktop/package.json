{
  "name": "mini-player-brave",
  "productName": "Mini Player",
  "version": "1.0.0",
  "description": "Mini reproductor flotante de YouTube que usa Brave (sin anuncios)",
  "author": "Johan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "com.johan.miniplayer",
    "productName": "Mini Player",
    "afterPack": "build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini Player",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MiniPlayer-Setup-${version}.exe"
    }
  }
}
